{
  "name": "desafio-jaguar",
  "version": "29.08.10",
  "description": "Aplicación oficial para la competencia Desafío Jaguar",
  "author": "Luis Mauricio Pat Martinez",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"cross-env NODE_ENV=development vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.desafiojaguar.app",
    "productName": "Desafío jaguar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/icono.ico",
        "to": "icono.ico"
      }
    ],
    "win": {
      "icon": "electron/icono.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "electron/icono.ico",
      "uninstallerIcon": "electron/icono.ico",
      "shortcutName": "Desafío jaguar"
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "pptxgenjs": "^4.0.0",
    "react": "^18.x.x",
    "react-custom-roulette": "^1.4.1",
    "react-dom": "^18.x.x",
    "react-qr-code": "^2.0.15",
    "react-router-dom": "^7.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react-swc": "^3.8.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.x.x",
    "electron": "^30.x.x",
    "electron-builder": "^24.13.3",
    "vite": "^5.x.x",
    "wait-on": "^7.2.0"
  }
}
